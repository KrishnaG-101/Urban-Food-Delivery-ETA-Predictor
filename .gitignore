# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Test & linter caches
.pytest_cache/

# Jupyter Notebook checkpoints & local config
.ipynb_checkpoints/
.jupyter/
.ipython/

# Virtual environments & IDE settings
.venv/
.vscode/

# Environment files
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db

# Model binaries (track only the production artifact)
models/*.bin
!models/model.bin

# Explicitly track raw dataset
!data/raw/food_delivery.csv
